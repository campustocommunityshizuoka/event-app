                <div>
                  <p className="text-xs opacity-90 font-bold mb-0.5">GUILD MEMBER</p>
                  <h2 className="text-xl font-black tracking-wide truncate max-w-[200px]">{profile.username || profile.email.split('@')[0]}</h2>
