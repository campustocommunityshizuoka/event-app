                     <div className="flex items-center gap-2">
                       <span className={`text-[10px] font-bold px-2 py-1 rounded-full shrink-0 ${app.status === 'approved' ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-500'}`}>
